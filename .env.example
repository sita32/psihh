# Настройки для docker compose. Скопируйте в .env и поменяйте пароли:
#   cp .env.example .env
# Файл .env в git не попадает.

# Порт сайта на компьютере: http://localhost (если 80 занят – например, 8080)
HTTP_PORT=80

# PostgreSQL
POSTGRES_DB=ryadom
POSTGRES_USER=ryadom
POSTGRES_PASSWORD=change-me-postgres
# Порт на компьютере для клиентов БД (DBeaver, DataGrip, psql); доступен только с localhost
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=change-me-redis

# Сервер API
# Секрет подписи токенов входа: длинная случайная строка, например: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret
# true – cookie входа только по HTTPS (на боевом сервере); локально сайт открыт по HTTP
COOKIE_SECURE=false
