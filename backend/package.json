{
  "name": "ryadom-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Сервер «Рядом»: REST API на Express, PostgreSQL, Redis",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "8.3.0",
    "bcrypt": "6.0.0",
    "express": "5.2.1",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "multer": "2.4.0",
    "pg": "8.23.1",
    "socket.io": "4.8.4"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/tests/global-setup.js",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageDirectory": "/tmp/coverage",
    "testTimeout": 15000
  },
  "devDependencies": {
    "jest": "30.5.2",
    "supertest": "7.3.1"
  }
}
