        timestamptz created_at
        timestamptz updated_at
    }
    conversations {
        bigint id PK
        bigint client_id FK
        bigint psychologist_id FK
        timestamptz created_at
        timestamptz last_message_at
    }
    messages {
        bigint id PK
        bigint conversation_id FK
        bigint sender_id FK
        text body
        text attachment_key
        timestamptz created_at
        timestamptz edited_at
        timestamptz read_at
        timestamptz deleted_at
    }
    notifications {
        bigint id PK
        bigint user_id FK
        varchar type
        varchar title
        text body
        jsonb payload
        timestamptz read_at
        timestamptz created_at
    }
    audit_log {
        bigint id PK
        bigint actor_id FK
        varchar action
        varchar entity_type
        bigint entity_id
        jsonb details
        inet ip
        timestamptz created_at
    }
